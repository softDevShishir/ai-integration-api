# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# Provider used when a request doesn't send "provider": claude (default) or gemini
DEFAULT_PROVIDER=claude

# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides (defaults shown)
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=2048

# Required for provider "gemini": your Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
# Faster/lighter alternative: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_TOKENS=2048

# PostgreSQL holding product data for /api/ask/rag (defaults shown).
# docker compose overrides DB_URL to point at its own postgres service.
DB_URL=jdbc:postgresql://localhost:5432/shop
DB_USERNAME=postgres
DB_PASSWORD=secret
# Host port docker compose publishes postgres on. Change it (and DB_URL above) if 5432 is taken.
DB_HOST_PORT=5432

# JWT signing secret — MUST be changed for anything beyond local testing.
# Must be at least 32 bytes long (HMAC-SHA256 requirement).
JWT_SECRET=this-is-a-hardcoded-test-secret-key-for-dev-only-change-me-32bytes
JWT_EXPIRATION_MS=3600000

SERVER_PORT=8080
